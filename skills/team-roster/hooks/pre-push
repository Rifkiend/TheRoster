#!/bin/bash
# Git pre-push hook — team-roster skill v1.4.
# Blocks the push if the team roster is missing, invalid, or stale,
# OR if the work ledger has a double claim / unknown owner,
# OR if the feature registry has a duplicate id / entry / unknown owner,
# OR if the remote moved while you were working (a feature version is
# newer on the remote, or a remote active claim covers your files).
# Installed by scripts/install-hook.sh into .git/hooks/pre-push
# Bypass only in an emergency, and say so in the commit message:
#   git push --no-verify
set -e
ROSTER="team/roster.json"
if [ ! -f "$ROSTER" ]; then
  ROSTER="friends/roster.json"
fi
if [ ! -f "$ROSTER" ]; then
  ROSTER="roster.json"
fi
if [ ! -f "$ROSTER" ]; then
  echo "pre-push: no roster found (looked for team/roster.json, friends/roster.json, roster.json)."
  echo "pre-push: copy roster.example.json to team/roster.json and fill in your real team, then push again."
  exit 1
fi
# Find a script: prefer the skill copy, fall back to a project copy.
find_script() {
  for candidate in "skills/team-roster/scripts/$1" ".agents/skills/team-roster/scripts/$1" ".claude/skills/team-roster/scripts/$1" ".github/skills/team-roster/scripts/$1" "scripts/$1"; do
    if [ -f "$candidate" ]; then echo "$candidate"; return 0; fi
  done
  return 1
}
CHECK_ROSTER="$(find_script check_roster.py)" || { echo "pre-push: check_roster.py not found — cannot verify roster, blocking push."; exit 1; }
python3 "$CHECK_ROSTER" "$ROSTER"

WORK="team/work.json"
if [ ! -f "$WORK" ]; then
  WORK="friends/work.json"
fi
if [ ! -f "$WORK" ]; then
  WORK="work.json"
fi
if [ -f "$WORK" ]; then
  CLAIM="$(find_script claim.py)" || { echo "pre-push: claim.py not found — cannot verify work ledger, blocking push."; exit 1; }
  python3 "$CLAIM" check "$WORK" --roster "$ROSTER"
else
  echo "pre-push: no work ledger found (team/work.json) — roster check passed, skipping claim check."
  echo "pre-push: copy work.example.json to team/work.json to enable anti-collision checks."
fi

FEATURES="team/features.json"
if [ ! -f "$FEATURES" ]; then
  FEATURES="friends/features.json"
fi
if [ ! -f "$FEATURES" ]; then
  FEATURES="features.json"
fi
if [ -f "$FEATURES" ]; then
  FEAT="$(find_script features.py)" || { echo "pre-push: features.py not found — cannot verify feature registry, blocking push."; exit 1; }
  python3 "$FEAT" check "$FEATURES" --roster "$ROSTER"
else
  echo "pre-push: no feature registry found (team/features.json) — skipping feature check."
  echo "pre-push: copy features.example.json to team/features.json to enable reuse checks."
fi

# 4th check: did the remote move while you were working? (v1.4 — the
# blind-spot check.) If there is no remote / no remote branch yet, this
# is the first sync and the check passes with a note. If the fetch fails
# (no network), it only warns — offline work is not blocked.
if [ -f "$FEATURES" ]; then
  SYNC="$(find_script sync_check.py)" || { echo "pre-push: sync_check.py not found — cannot check the remote, blocking push."; exit 1; }
  python3 "$SYNC" "$FEATURES" "${WORK:-team/work.json}"
else
  echo "pre-push: no feature registry found (team/features.json) — skipping sync check."
fi
